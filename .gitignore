# Xcode
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Xcode project user state — keep the shared project file, drop personal settings
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/

# Secrets — the Azure key lives in the iOS Keychain, never in the repo.
# This is here so a stray local config file can't be committed by accident.
Secrets.plist
*.env
.dev.vars

# Local development certificate authority made by tools/serve.py, so the phone
# can reach the web app over a trusted https origin. Contains a private key,
# and is specific to one machine's WiFi address. Never commit it.
tools/.devcert/
# OpenSSL drops a serial-number sidecar here when serve.py signs a leaf cert.
tools/.srl

# Wrangler's local scratch state from deploying the card-assistant Worker.
worker/.wrangler/

# macOS
.DS_Store
